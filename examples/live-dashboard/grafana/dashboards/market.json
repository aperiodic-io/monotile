{
  "uid": "brrrrr-market",
  "title": "brrrrr: live market",
  "editable": true,
  "schemaVersion": 39,
  "refresh": "1s",
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "1s",
      "5s",
      "10s",
      "30s",
      "1m"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "symbol",
        "type": "custom",
        "query": "BTC,ETH,SOL",
        "label": "Symbol",
        "current": {
          "text": "BTC",
          "value": "BTC"
        },
        "options": [
          {
            "text": "BTC",
            "value": "BTC",
            "selected": true
          },
          {
            "text": "ETH",
            "value": "ETH",
            "selected": false
          },
          {
            "text": "SOL",
            "value": "SOL",
            "selected": false
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "candlestick",
      "title": "$symbol: 5-second candles (the live view bars_5s)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "brrrrr"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 16,
        "h": 11
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "brrrrr"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT bucket AS time, open, high, low, close, volume\nFROM bars_5s\nWHERE symbol = '$symbol' AND $__timeFilter(bucket)\nORDER BY bucket"
        }
      ],
      "options": {
        "mode": "candles+volume",
        "candleStyle": "candles",
        "colorStrategy": "open-close",
        "colors": {
          "up": "#12a27a",
          "down": "#e5484d"
        },
        "includeAllFields": false,
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "axisPlacement": "right"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "table",
      "title": "Latest prices (the trades of the time range)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "brrrrr"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 11
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "brrrrr"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT symbol, last(price, ts) AS price,\n       (last(price, ts) / first(price, ts) - 1) * 100 AS change,\n       count(*) AS trades\nFROM trades\nWHERE $__timeFilter(ts)\nGROUP BY symbol\nORDER BY symbol"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "md"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "custom": {
            "minWidth": 70,
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "change"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "#e5484d",
                      "value": null
                    },
                    {
                      "color": "#12a27a",
                      "value": 0
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "trades"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Quoted spread, bps (the live view spread_1s)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "brrrrr"
      },
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "brrrrr"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT second AS time, symbol AS metric, spread_bps\nFROM spread_1s\nWHERE $__timeFilter(second)\nORDER BY second"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0
          },
          "unit": "none",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "$symbol: price and 1-minute VWAP (bars_1m)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "brrrrr"
      },
      "gridPos": {
        "x": 12,
        "y": 11,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "brrrrr"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT bucket AS time, close AS price\nFROM bars_5s\nWHERE symbol = '$symbol' AND $__timeFilter(bucket)\nORDER BY bucket"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "brrrrr"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT minute AS time, vwap AS \"1m VWAP\"\nFROM bars_1m\nWHERE symbol = '$symbol' AND $__timeFilter(minute)\nORDER BY minute"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1
          },
          "decimals": 2
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "1m VWAP"
            },
            "properties": [
              {
                "id": "custom.lineInterpolation",
                "value": "stepAfter"
              },
              {
                "id": "custom.lineWidth",
                "value": 2
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Trades per 5 seconds",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "brrrrr"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "brrrrr"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT bucket AS time, symbol AS metric, trades\nFROM bars_5s\nWHERE $__timeFilter(bucket)\nORDER BY bucket"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 0,
            "stacking": {
              "mode": "normal"
            }
          },
          "decimals": 0,
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ]
}